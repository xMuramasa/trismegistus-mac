{
  "$description": "Trismegistus-mac design tokens: the one source of TrismegistusUI's Tokens.swift (scripts/gen-tokens.py) and of the Penpot token set 'Trismegistus'. Colours written {endfield.<name>} come from endfield-dotfiles/theme/palette.json (read-only). Decided with Martin 2026-11-01 (#33): strict spacing scale, rounding up (6 -> 8, 10 -> 12); Inter and JetBrains Mono, as in the Penpot draft.",
  "color": {
    "palette": {
      "paper": {
        "$value": "{endfield.paper}"
      },
      "raised": {
        "$value": "{endfield.raised}"
      },
      "sunken": {
        "$value": "{endfield.sunken}"
      },
      "rule": {
        "$value": "{endfield.rule}"
      },
      "ink": {
        "$value": "{endfield.ink}"
      },
      "dark-panel": {
        "$value": "{endfield.darkPanel}"
      },
      "secondary": {
        "$value": "{endfield.secondary}"
      },
      "muted": {
        "$value": "{endfield.muted}"
      },
      "yellow": {
        "$value": "{endfield.yellow}"
      },
      "blue": {
        "$value": "{endfield.blue}"
      },
      "green": {
        "$value": "{endfield.green}"
      },
      "magenta": {
        "$value": "{endfield.magenta}"
      },
      "red": {
        "$value": "{endfield.red}"
      },
      "border-inactive": {
        "$value": "{endfield.borderInactive}"
      },
      "terminal-green": {
        "$value": "#00875A",
        "$description": "Endfield ANSI green, darkened: readable as text on paper"
      },
      "terminal-red": {
        "$value": "#C4271F",
        "$description": "Endfield ANSI red, darkened"
      },
      "ark-orange": {
        "$value": "#E86600",
        "$description": "Arknights item-card orange: terminal card headers"
      },
      "on-steel": {
        "$value": "#E9E9E9",
        "$description": "text and icons on the steel bar and on ink"
      },
      "accent-cyan": {
        "$value": "#1FE5E0"
      },
      "accent-magenta": {
        "$value": "#DA16DC"
      }
    },
    "role": {
      "text": {
        "primary": {
          "$value": "{color.palette.ink}"
        },
        "secondary": {
          "$value": "{color.palette.secondary}"
        },
        "muted": {
          "$value": "{color.palette.muted}"
        },
        "on-dark": {
          "$value": "{color.palette.on-steel}"
        },
        "link": {
          "$value": "{color.palette.blue}"
        },
        "error": {
          "$value": "{color.palette.red}"
        }
      },
      "surface": {
        "window": {
          "$value": "{color.palette.paper}"
        },
        "raised": {
          "$value": "{color.palette.raised}"
        },
        "sunken": {
          "$value": "{color.palette.sunken}"
        },
        "terminal": {
          "$value": "{color.palette.ink}"
        },
        "inverse": {
          "$value": "{color.palette.ink}",
          "$description": "ink behind a chip, a toggle that is on, a pressed button, a switch that is on"
        }
      },
      "line": {
        "rule": {
          "$value": "{color.palette.rule}"
        },
        "strong": {
          "$value": "{color.palette.ink}"
        },
        "on-dark": {
          "$value": {
            "color": "{color.palette.on-steel}",
            "opacity": "{opacity.rule-on-dark}"
          },
          "$description": "a rule on the ink terminal pane"
        },
        "outline-on-dark": {
          "$value": {
            "color": "{color.palette.on-steel}",
            "opacity": "{opacity.outline-on-dark}"
          },
          "$description": "an outline on the steel bar"
        },
        "paper-cross": {
          "$value": {
            "color": "{color.palette.ink}",
            "opacity": "{opacity.paper-crosses}"
          },
          "$description": "the crosses on the paper ground"
        }
      },
      "mark": {
        "empty": {
          "$value": "{color.palette.border-inactive}",
          "$description": "the mark of an empty list"
        }
      },
      "marker": {
        "$value": "{color.palette.magenta}",
        "$description": "the square beside an approval, and the approval badge"
      },
      "selection": {
        "$value": "{color.palette.yellow}"
      },
      "status": {
        "ok": {
          "$value": "{color.palette.terminal-green}"
        },
        "error": {
          "$value": "{color.palette.terminal-red}"
        },
        "online": {
          "$value": "{color.palette.green}"
        },
        "warn": {
          "$value": "{color.palette.yellow}",
          "$description": "the warn band and errors on steel (bright, for fills)"
        },
        "bad": {
          "$value": "{color.palette.red}",
          "$description": "the bad and critical band, error bars (bright, for fills; text on paper uses error)"
        }
      },
      "bar": {
        "start": {
          "$value": "{color.palette.secondary}"
        },
        "middle": {
          "$value": "{color.palette.dark-panel}"
        },
        "end": {
          "$value": "{color.palette.ink}"
        },
        "rule": {
          "$value": "{color.palette.ink}"
        }
      },
      "card": {
        "header": {
          "$value": "{color.palette.ark-orange}"
        },
        "on-header": {
          "$value": "{color.palette.raised}",
          "$description": "the title and chevron on a card's header"
        },
        "accents": {
          "$value": [
            "{color.palette.accent-cyan}",
            "{color.palette.accent-magenta}",
            "{color.palette.yellow}",
            "{color.palette.muted}"
          ],
          "$description": "top to bottom; the last at opacity.track"
        }
      },
      "title-rule": {
        "$value": [
          "{color.palette.magenta}",
          "{color.palette.yellow}",
          "{color.palette.green}"
        ]
      }
    }
  },
  "opacity": {
    "secondary-on-dark": {
      "$value": 0.7
    },
    "outline-on-dark": {
      "$value": 0.5
    },
    "rule-on-dark": {
      "$value": 0.12
    },
    "track": {
      "$value": 0.5
    },
    "paper-crosses": {
      "$value": 0.55
    },
    "terminal-contours": {
      "$value": 0.3
    },
    "card-detail": {
      "$value": 0.85,
      "$description": "the duration on a terminal card's header"
    }
  },
  "space": {
    "$description": "Strict scale. Literals in views round UP to the next step (3 -> 4, 5/6/7 -> 8, 10 -> 12, 14 -> 16, 26 -> 32). 0 and the 1 pt hairline are not spacing steps.",
    "xxs": {
      "$value": 2
    },
    "xs": {
      "$value": 4
    },
    "s": {
      "$value": 8
    },
    "m": {
      "$value": 12
    },
    "l": {
      "$value": 16
    },
    "xl": {
      "$value": 20
    },
    "xxl": {
      "$value": 24
    },
    "xxxl": {
      "$value": 32
    },
    "huge": {
      "$value": 40
    }
  },
  "font": {
    "family": {
      "ui": {
        "$value": "Inter"
      },
      "mono": {
        "$value": "JetBrains Mono"
      }
    },
    "role": {
      "heading": {
        "$value": {
          "family": "ui",
          "size": 15,
          "weight": 700,
          "tracking": 0.6,
          "uppercase": true
        }
      },
      "title": {
        "$value": {
          "family": "ui",
          "size": 15,
          "weight": 600,
          "tracking": 0,
          "uppercase": false
        }
      },
      "headline": {
        "$value": {
          "family": "ui",
          "size": 13,
          "weight": 600,
          "tracking": 0,
          "uppercase": false
        }
      },
      "body": {
        "$value": {
          "family": "ui",
          "size": 13,
          "weight": 400,
          "tracking": 0,
          "uppercase": false
        }
      },
      "callout": {
        "$value": {
          "family": "ui",
          "size": 12,
          "weight": 400,
          "tracking": 0,
          "uppercase": false
        }
      },
      "caption": {
        "$value": {
          "family": "ui",
          "size": 11,
          "weight": 400,
          "tracking": 0,
          "uppercase": false
        }
      },
      "label": {
        "$value": {
          "family": "ui",
          "size": 10,
          "weight": 600,
          "tracking": 0.8,
          "uppercase": true
        }
      },
      "button": {
        "$value": {
          "family": "ui",
          "size": 12,
          "weight": 600,
          "tracking": 0.3,
          "uppercase": false
        }
      },
      "mono": {
        "$value": {
          "family": "mono",
          "size": 12,
          "weight": 400,
          "tracking": 0,
          "uppercase": false
        }
      },
      "mono-small": {
        "$value": {
          "family": "mono",
          "size": 11,
          "weight": 400,
          "tracking": 0,
          "uppercase": false
        }
      }
    }
  },
  "icon": {
    "xxs": {
      "$value": 8,
      "$description": "folding chevrons (bold)"
    },
    "xs": {
      "$value": 9
    },
    "s": {
      "$value": 10
    },
    "m": {
      "$value": 11
    },
    "l": {
      "$value": 14
    },
    "empty": {
      "$value": 28,
      "$description": "an empty state's symbol"
    }
  },
  "size": {
    "row": {
      "$value": 52,
      "$description": "a conversation row; also the unit of the terminal card cap"
    },
    "row-compact": {
      "$value": 40
    },
    "card-header": {
      "$value": 24
    },
    "card-max-rows": {
      "$value": 8
    },
    "chat-column": {
      "$value": 700
    },
    "popover": {
      "$value": {
        "width": 380,
        "height": 560
      }
    },
    "sidebar": {
      "$value": {
        "min": 220,
        "default": 260,
        "max": 340
      }
    },
    "terminal": {
      "$value": {
        "min": 280,
        "default": 360,
        "max": 560
      }
    },
    "window-min": {
      "$value": {
        "width": 1100,
        "height": 640
      }
    },
    "title-rule": {
      "$value": {
        "magenta": 48,
        "yellow": 120,
        "height": 4,
        "green": 24
      },
      "$description": "the window's conversation header; green is a minimum, it stretches"
    },
    "control": {
      "$value": 30,
      "$description": "text field and button height"
    },
    "title-rule-small": {
      "$value": {
        "magenta": 34,
        "yellow": 88,
        "green": 18,
        "height": 2
      },
      "$description": "TitleRule under a heading"
    },
    "row-tool": {
      "$value": 28,
      "$description": "tool and subagent rows"
    },
    "dot": {
      "$value": 7,
      "$description": "status dot"
    },
    "marker": {
      "$value": 8,
      "$description": "the approval banner's square"
    },
    "cursor": {
      "$value": {
        "width": 7,
        "height": 13
      },
      "$description": "a running command's block cursor"
    },
    "card-dash": {
      "$value": {
        "width": 8,
        "height": 1.5
      },
      "$description": "the dash leading a terminal card's header"
    },
    "card-body-min": {
      "$value": 54
    },
    "card-accent": {
      "$value": 11,
      "$description": "height of one accent segment (its width is stroke.card-accent)"
    },
    "grip": {
      "$value": 7,
      "$description": "a divider's drag area"
    },
    "menu-button": {
      "$value": 22,
      "$description": "the square of an icon-only menu (the conversation's ellipsis)"
    },
    "meter-cell": {
      "$value": {
        "width": 5,
        "height": 10
      },
      "$description": "one cell of the context meter"
    },
    "picker-max": {
      "$value": 240,
      "$description": "the Commands view's conversation picker"
    },
    "tags-max": {
      "$value": 220,
      "$description": "the conversation header's tag strip"
    },
    "header-mark": {
      "$value": 18,
      "$description": "the T mark in the popover header"
    },
    "empty-mark": {
      "$value": 42,
      "$description": "the T mark of an empty state"
    },
    "settings": {
      "$value": {
        "width": 380,
        "height": 520
      }
    },
    "pairing": {
      "$value": {
        "width": 380,
        "height": 460
      }
    },
    "handoff-sheet": {
      "$value": {
        "width": 440
      }
    }
  },
  "radius": {
    "none": {
      "$value": 0
    },
    "card": {
      "$value": 8
    }
  },
  "stroke": {
    "hairline": {
      "$value": 1
    },
    "hairline-fine": {
      "$value": 0.5
    },
    "accent": {
      "$value": 2
    },
    "card-accent": {
      "$value": 4
    },
    "rule": {
      "$value": 4
    },
    "mark": {
      "$value": 3,
      "$description": "selection and accent bars (rows, the banner's top, notices)"
    }
  },
  "shadow": {
    "card": {
      "$value": {
        "color": "{color.palette.ink}",
        "opacity": 0.16,
        "radius": 5,
        "x": 0,
        "y": 1
      }
    },
    "panel": {
      "$value": {
        "color": "{color.palette.ink}",
        "opacity": 0.12,
        "radius": 12,
        "x": 0,
        "y": 4
      },
      "$description": "the approval banner (Endfield's hairline panel style)"
    }
  },
  "motion": {
    "panel": {
      "$value": {
        "duration": 0.3,
        "curve": "easeInOut"
      },
      "$description": "sidebar and terminal show/hide"
    },
    "settle": {
      "$value": {
        "duration": 0.15
      },
      "$description": "settledWidth"
    }
  }
}
